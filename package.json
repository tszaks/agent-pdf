{
  "name": "agent-pdf",
  "version": "0.1.0",
  "description": "World-class PDF generation for AI agents. Beautiful templates, zero design decisions required.",
  "keywords": ["pdf", "mcp", "ai", "agents", "puppeteer", "templates"],
  "license": "MIT",
  "author": "Tyler Szakacs",
  "repository": {
    "type": "git",
    "url": "https://github.com/tszaks/agent-pdf.git"
  },
